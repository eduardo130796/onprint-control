# Produção — copie para .env.prod e troque TODOS os valores marcados (ver docs/DEPLOY_VPS.md).
# Gere segredos com:  openssl rand -hex 32

# Domínio já apontado para o IP da VPS (registro A); o HTTPS é emitido sozinho
DOMINIO=erp.suaempresa.com.br
APP_URL=https://erp.suaempresa.com.br

# Banco (a senha aparece em dois lugares)
POSTGRES_USER=onprint
POSTGRES_PASSWORD=TROQUE_senha_forte_do_banco
POSTGRES_DB=onprint
DATABASE_URL=postgresql://onprint:TROQUE_senha_forte_do_banco@db:5432/onprint

# JWT: dois segredos diferentes, 32+ caracteres (a API não sobe com valores fracos)
JWT_ACCESS_SECRET=TROQUE_openssl_rand_hex_32
JWT_REFRESH_SECRET=TROQUE_outro_openssl_rand_hex_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Primeiro acesso (criado só se o banco não tiver usuários; troca de senha obrigatória no 1º login).
# Obrigatório numa instalação nova: senha com 12+ caracteres, sem o "TROQUE" (senão o seed para)
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_SENHA_INICIAL=TROQUE_senha_provisoria
# true = cria o catálogo de exemplo (banners, canecas…) no primeiro start
SEED_EXEMPLOS=false

UPLOAD_MAX_MB=200
TZ=America/Sao_Paulo
LOG_LEVEL=info

# Multiempresa: conexões por empresa e quantas empresas mantêm o pool aberto ao mesmo tempo
DB_CONEXOES_POR_EMPRESA=3
DB_MAX_EMPRESAS_ABERTAS=60
# Slug da empresa padrão (dados já existentes no schema public), usado nos links públicos
EMPRESA_PADRAO_SLUG=principal

# E-mail (convite de usuário, "esqueci a senha"). Qualquer provedor SMTP: Gmail/Workspace, Hostinger,
# Zoho, Amazon SES, Brevo… Sem SMTP_HOST, os e-mails só aparecem no log da API.
SMTP_HOST=
SMTP_PORTA=587
# true só para a porta 465 (TLS direto); na 587 o TLS é negociado sozinho
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=GrafyGo <nao-responda@suaempresa.com.br>

# Assinaturas: plano das empresas novas (essencial | profissional | completo), contato do suporte
# mostrado em "Minha assinatura" e por quantos segundos a situação da assinatura fica em cache
PLANO_PADRAO=profissional
SUPORTE_CONTATO=
CACHE_EMPRESAS_SEGUNDOS=30

# Pagamento online da mensalidade (Asaas). Sem ASAAS_API_KEY: modo manual (o suporte registra as cobranças).
# Chave: painel do Asaas → Integrações → Chaves de API. Sandbox para testes; producao para cobrar de verdade.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# Token que você também cadastra no webhook do Asaas (openssl rand -hex 32); obrigatório com a chave
ASAAS_WEBHOOK_TOKEN=
# PIX Automático: só depois que o Asaas liberar o recurso na sua conta (peça ao gerente de contas)
ASAAS_PIX_AUTOMATICO=false
# NFS-e automática da mensalidade (a conta Asaas precisa estar habilitada para emitir notas)
ASAAS_NF_ATIVA=false
# Use o id do serviço municipal (listado pelo Asaas) OU o código manual (ex.: 01.07)
ASAAS_NF_SERVICO_ID=
ASAAS_NF_SERVICO_CODIGO=
ASAAS_NF_SERVICO_NOME=Licença de uso de software (GrafyGo)
ASAAS_NF_OBSERVACOES=
ASAAS_NF_RETER_ISS=false
# Alíquotas em %
ASAAS_NF_ISS=0
ASAAS_NF_PIS=0
ASAAS_NF_COFINS=0
ASAAS_NF_CSLL=0
ASAAS_NF_INSS=0
ASAAS_NF_IR=0

# Consulta de CEP e CNPJ (BrasilAPI, ViaCEP, CNPJ.ws) feita pela API para preencher cadastros.
# false = desliga (o usuário preenche o endereço e os dados à mão)
CONSULTAS_EXTERNAS=true

# Painel da plataforma (/plataforma): primeiro administrador — obrigatório em produção (troque!)
# Senha com 12+ caracteres, sem o "TROQUE" (senão o seed para ao criar o administrador)
PLATAFORMA_ADMIN_EMAIL=voce@suaempresa.com.br
PLATAFORMA_ADMIN_SENHA=TROQUE_senha_forte_do_painel
# Página pública "Criar conta" (teste grátis); false = só o suporte cria empresas
CADASTRO_PUBLICO=true
# Teto de cadastros pela internet por hora, somando todos os IPs (além do limite por IP)
CADASTROS_POR_HORA=30
