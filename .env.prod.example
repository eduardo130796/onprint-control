# Produção — copie para .env.prod e troque TODOS os valores marcados (ver docs/DEPLOY_VPS.md).
# Gere segredos com:  openssl rand -hex 32

# Domínio já apontado para o IP da VPS (registro A); o HTTPS é emitido sozinho
DOMINIO=erp.suaempresa.com.br
APP_URL=https://erp.suaempresa.com.br

# Banco (a senha aparece em dois lugares)
POSTGRES_USER=onprint
POSTGRES_PASSWORD=TROQUE_senha_forte_do_banco
POSTGRES_DB=onprint
DATABASE_URL=postgresql://onprint:TROQUE_senha_forte_do_banco@db:5432/onprint

# JWT: dois segredos diferentes, 32+ caracteres (a API não sobe com valores fracos)
JWT_ACCESS_SECRET=TROQUE_openssl_rand_hex_32
JWT_REFRESH_SECRET=TROQUE_outro_openssl_rand_hex_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Primeiro acesso (criado só se o banco não tiver usuários; troca de senha obrigatória no 1º login)
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_SENHA_INICIAL=TROQUE_senha_provisoria
# true = cria o catálogo de exemplo (banners, canecas…) no primeiro start
SEED_EXEMPLOS=false

UPLOAD_MAX_MB=200
TZ=America/Sao_Paulo
LOG_LEVEL=info

# Multiempresa: conexões por empresa e quantas empresas mantêm o pool aberto ao mesmo tempo
DB_CONEXOES_POR_EMPRESA=3
DB_MAX_EMPRESAS_ABERTAS=60
# Slug da empresa padrão (dados já existentes no schema public), usado nos links públicos
EMPRESA_PADRAO_SLUG=principal
