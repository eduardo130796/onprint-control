{
  "name": "@onprint/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrar": "tsx prisma/migrar.ts",
    "prisma:reset": "tsx prisma/resetar.ts && tsx prisma/migrar.ts && tsx prisma/seed.ts",
    "empresa:criar": "tsx prisma/criar-empresa.ts",
    "assinatura": "tsx prisma/assinatura.ts",
    "admin-plataforma": "tsx prisma/admin-plataforma.ts",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@onprint/shared": "0.1.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "openapi-types": "^12.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
