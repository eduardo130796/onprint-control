}

// ─── 8.7 Financeiro (parte usada na conversão; completado na Fase 6) ───────

enum StatusConta {
  aberto
  parcial
  pago
  vencido
  cancelado

  @@map("status_conta")
}

enum StatusComissao {
  prevista
  liberada
  paga

  @@map("status_comissao")
}

model ContaReceber {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId           String?     @map("pedido_id") @db.Uuid
  clienteId          String      @map("cliente_id") @db.Uuid
  descricao          String
  parcela            Int         @default(1)
  totalParcelas      Int         @default(1) @map("total_parcelas")
  valor              Decimal     @db.Decimal(12, 2)
  vencimento         DateTime    @db.Date
  status             StatusConta @default(aberto)
  valorPago          Decimal     @default(0) @map("valor_pago") @db.Decimal(12, 2)
  juros              Decimal     @default(0) @db.Decimal(12, 2)
  multa              Decimal     @default(0) @db.Decimal(12, 2)
  desconto           Decimal     @default(0) @db.Decimal(12, 2)
  pagoEm             DateTime?   @map("pago_em") @db.Date
  observacao         String?
  formaPagamentoId   String?     @map("forma_pagamento_id") @db.Uuid
  contaFinanceiraId  String?     @map("conta_financeira_id") @db.Uuid
  categoriaId        String?     @map("categoria_id") @db.Uuid
  anexoId            String?     @map("anexo_id") @db.Uuid
  motivoCancelamento String?     @map("motivo_cancelamento")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?     @map("created_by") @db.Uuid

  pedido          Pedido?               @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  cliente         Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  formaPagamento  FormaPagamento?       @relation(fields: [formaPagamentoId], references: [id], onDelete: SetNull)
  contaFinanceira ContaFinanceira?      @relation(fields: [contaFinanceiraId], references: [id], onDelete: SetNull)
  categoria       CategoriaFinanceira?  @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  anexo           Arquivo?              @relation("ContaReceberAnexo", fields: [anexoId], references: [id], onDelete: SetNull)
  movimentos      MovimentoFinanceiro[]
  caixaMovimentos CaixaMovimento[]

  @@index([pedidoId])
  @@index([clienteId])
  @@index([status])
  @@index([vencimento])
  @@map("contas_receber")
}

model Comissao {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendedorId String         @map("vendedor_id") @db.Uuid
  pedidoId   String         @map("pedido_id") @db.Uuid
  base       Decimal        @db.Decimal(12, 2)
  percentual Decimal        @db.Decimal(5, 2)
  valor      Decimal        @db.Decimal(12, 2)
  status     StatusComissao @default(prevista)
  liberadaEm DateTime?      @map("liberada_em") @db.Timestamptz(3)
  pagaEm     DateTime?      @map("paga_em") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendedor   Usuario               @relation("ComissaoVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  pedido     Pedido                @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  movimentos MovimentoFinanceiro[]

  @@index([vendedorId])
  @@index([pedidoId])
  @@index([status])
  @@map("comissoes")
}

// ─── 8.5 Produção ───────────────────────────────────────────────────────────

enum EtapaProducao {
  fila
  pre_impressao
  impressao
  acabamento
  conferencia
  concluido

  @@map("etapa_producao")
}

model OrdemProducao {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero               String        @unique
  pedidoId             String        @map("pedido_id") @db.Uuid
  pedidoItemId         String        @map("pedido_item_id") @db.Uuid
  quantidade           Decimal       @db.Decimal(12, 3)
  largura              Decimal?      @db.Decimal(10, 3)
  altura               Decimal?      @db.Decimal(10, 3)
  areaM2               Decimal       @default(0) @map("area_m2") @db.Decimal(12, 3)
  etapaAtual           EtapaProducao @default(fila) @map("etapa_atual")
  /// Etapa própria do kanban (criada pelo usuário com base = etapaAtual)
  etapaPersonalizadaId String?       @map("etapa_personalizada_id") @db.Uuid
  maquinaId            String?       @map("maquina_id") @db.Uuid
  responsavelId        String?       @map("responsavel_id") @db.Uuid
  prioridade           Prioridade    @default(normal)
  horasEstimadas       Decimal       @default(0) @map("horas_estimadas") @db.Decimal(8, 2)
  dataInicioPrevista   DateTime?     @map("data_inicio_prevista") @db.Date
  dataFimPrevista      DateTime?     @map("data_fim_prevista") @db.Date
  dataInicioReal       DateTime?     @map("data_inicio_real") @db.Timestamptz(3)
  dataFimReal          DateTime?     @map("data_fim_real") @db.Timestamptz(3)
  /// Quando a OP entrou na etapa atual (base do "tempo na etapa")
  entrouEtapaEm        DateTime      @default(now()) @map("entrou_etapa_em") @db.Timestamptz(3)
  ordemKanban          Int           @default(0) @map("ordem_kanban")
  observacoes          String?
  cancelada            Boolean       @default(false)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy            String?       @map("created_by") @db.Uuid

  etapaPersonalizada   StatusConfig?         @relation("OpEtapaPersonalizada", fields: [etapaPersonalizadaId], references: [id], onDelete: SetNull)
  pedido               Pedido                @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  pedidoItem           PedidoItem            @relation(fields: [pedidoItemId], references: [id], onDelete: Restrict)
  maquina              Maquina?              @relation("OpMaquina", fields: [maquinaId], references: [id], onDelete: SetNull)
  responsavel          Usuario?              @relation("OpResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  historico            OpEtapaHistorico[]
  apontamentos         OpApontamento[]
  movimentacoesEstoque EstoqueMovimentacao[] @relation("MovimentacaoOp")
  etiquetasFila        EtiquetaFila[]

  @@index([pedidoId])
  @@index([pedidoItemId])
  @@index([etapaAtual])
  @@index([maquinaId])
  @@index([responsavelId])
  @@map("ordens_producao")
}

/// Fila de etiquetas de entrega a imprimir (uma pendente por OP; entra sozinha ao concluir a OP).
/// Índice único parcial na migration: só uma pendente (impressa_em nulo) por OP.
model EtiquetaFila {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordemProducaoId String    @map("ordem_producao_id") @db.Uuid
  pedidoId        String    @map("pedido_id") @db.Uuid
  /// true = entrou ao concluir a OP; false = adicionada por alguém
  automatica      Boolean   @default(false)
  criadaEm        DateTime  @default(now()) @map("criada_em") @db.Timestamptz(3)
  impressaEm      DateTime? @map("impressa_em") @db.Timestamptz(3)
  criadaPor       String?   @map("criada_por") @db.Uuid

  ordemProducao OrdemProducao @relation(fields: [ordemProducaoId], references: [id], onDelete: Cascade)
  pedido        Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([ordemProducaoId])
  @@index([impressaEm])
  @@map("etiquetas_fila")
}

model OpEtapaHistorico {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opId            String         @map("op_id") @db.Uuid
  etapaDe         EtapaProducao? @map("etapa_de")
  etapaPara       EtapaProducao  @map("etapa_para")
  usuarioId       String?        @map("usuario_id") @db.Uuid
  /// Tempo que a OP ficou na etapa anterior
  segundosNaEtapa Int            @default(0) @map("segundos_na_etapa")
  override        Boolean        @default(false)
  motivo          String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  op      OrdemProducao @relation(fields: [opId], references: [id], onDelete: Cascade)
  usuario Usuario?      @relation("OpHistoricoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([opId])
  @@index([createdAt])
  @@map("op_etapas_historico")
}

model OpApontamento {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opId                String    @map("op_id") @db.Uuid
  processoId          String?   @map("processo_id") @db.Uuid
  maquinaId           String?   @map("maquina_id") @db.Uuid
  operadorId          String?   @map("operador_id") @db.Uuid
  inicio              DateTime  @db.Timestamptz(3)
  fim                 DateTime? @db.Timestamptz(3)
  quantidadeProduzida Decimal   @default(0) @map("quantidade_produzida") @db.Decimal(12, 3)
  perda               Decimal   @default(0) @db.Decimal(12, 3)
  observacao          String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  op       OrdemProducao @relation(fields: [opId], references: [id], onDelete: Cascade)
  processo Processo?     @relation("ApontamentoProcesso", fields: [processoId], references: [id], onDelete: SetNull)
  maquina  Maquina?      @relation("ApontamentoMaquina", fields: [maquinaId], references: [id], onDelete: SetNull)
  operador Usuario?      @relation("ApontamentoOperador", fields: [operadorId], references: [id], onDelete: SetNull)

  @@index([opId])
  @@index([maquinaId])
  @@map("op_apontamentos")
}

/// Histórico de comentários da arte (cliente pelo link ou equipe interna).
model ArteComentario {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  arteId    String   @map("arte_id") @db.Uuid
  autorNome String   @map("autor_nome")
  usuarioId String?  @map("usuario_id") @db.Uuid
  origem    String
  texto     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  arte    Arte     @relation(fields: [arteId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation("ArteComentarioUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([arteId])
  @@map("arte_comentarios")
}

// ─── 8.6 Estoque ──────────────────────────────────────────────────────────────

enum TipoMovimentacao {
  entrada
  saida
  ajuste
  consumo_producao
  perda
  transferencia
  venda_pdv

  @@map("tipo_movimentacao")
}

model EstoqueLocal {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String   @unique
  descricao String?
  /// Local usado pela baixa automática da produção e pelo PDV
  padrao    Boolean  @default(false)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  saldos        EstoqueSaldo[]
  movimentacoes EstoqueMovimentacao[]
  entradas      EstoqueEntrada[]

  @@map("estoque_locais")
}

/// Entrada de mercadoria (nota do fornecedor). Cada item gera uma movimentação "entrada".
model EstoqueEntrada {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero       String   @unique
  fornecedorId String?  @map("fornecedor_id") @db.Uuid
  localId      String   @map("local_id") @db.Uuid
  notaFiscal   String?  @map("nota_fiscal")
  dataEntrada  DateTime @map("data_entrada") @db.Date
  total        Decimal  @default(0) @db.Decimal(14, 2)
  observacoes  String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?  @map("created_by") @db.Uuid

  fornecedor    Fornecedor?           @relation("EntradaFornecedor", fields: [fornecedorId], references: [id], onDelete: Restrict)
  local         EstoqueLocal          @relation(fields: [localId], references: [id], onDelete: Restrict)
  usuario       Usuario?              @relation("EntradaUsuario", fields: [createdBy], references: [id], onDelete: SetNull)
  itens         EstoqueEntradaItem[]
  movimentacoes EstoqueMovimentacao[]

  @@index([fornecedorId])
  @@index([dataEntrada])
  @@map("estoque_entradas")
}

model EstoqueEntradaItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entradaId     String  @map("entrada_id") @db.Uuid
  produtoId     String  @map("produto_id") @db.Uuid
  quantidade    Decimal @db.Decimal(12, 3)
  custoUnitario Decimal @map("custo_unitario") @db.Decimal(12, 4)
  total         Decimal @db.Decimal(14, 2)

  entrada EstoqueEntrada @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  produto Produto        @relation("EntradaItemProduto", fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([entradaId])
  @@index([produtoId])
  @@map("estoque_entrada_itens")
}

/// Toda mudança de saldo passa por aqui. Quantidade com sinal: positiva entra, negativa sai.
model EstoqueMovimentacao {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo            TipoMovimentacao
  produtoId       String           @map("produto_id") @db.Uuid
  localId         String           @map("local_id") @db.Uuid
  quantidade      Decimal          @db.Decimal(12, 3)
  custoUnitario   Decimal          @default(0) @map("custo_unitario") @db.Decimal(12, 4)
  /// Saldo do produto neste local logo após a movimentação
  saldoApos       Decimal          @map("saldo_apos") @db.Decimal(12, 3)
  motivo          String?
  opId            String?          @map("op_id") @db.Uuid
  pedidoId        String?          @map("pedido_id") @db.Uuid
  fornecedorId    String?          @map("fornecedor_id") @db.Uuid
  entradaId       String?          @map("entrada_id") @db.Uuid
  /// As duas pernas de uma transferência compartilham este id
  transferenciaId String?          @map("transferencia_id") @db.Uuid
  vendaPdvId      String?          @map("venda_pdv_id") @db.Uuid
  usuarioId       String?          @map("usuario_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  produto    Produto         @relation("MovimentacaoProduto", fields: [produtoId], references: [id], onDelete: Restrict)
  local      EstoqueLocal    @relation(fields: [localId], references: [id], onDelete: Restrict)
  op         OrdemProducao?  @relation("MovimentacaoOp", fields: [opId], references: [id], onDelete: SetNull)
  pedido     Pedido?         @relation("MovimentacaoPedido", fields: [pedidoId], references: [id], onDelete: SetNull)
  fornecedor Fornecedor?     @relation("MovimentacaoFornecedor", fields: [fornecedorId], references: [id], onDelete: SetNull)
  entrada    EstoqueEntrada? @relation(fields: [entradaId], references: [id], onDelete: SetNull)
  usuario    Usuario?        @relation("MovimentacaoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  vendaPdv   VendaPdv?       @relation(fields: [vendaPdvId], references: [id], onDelete: SetNull)

  @@index([produtoId, createdAt])
  @@index([localId])
  @@index([opId])
  @@index([pedidoId])
  @@index([tipo, createdAt])
  @@map("estoque_movimentacoes")
}

/// Saldo e custo médio por produto e local — alterado somente pelo service de estoque.
model EstoqueSaldo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId  String   @map("produto_id") @db.Uuid
  localId    String   @map("local_id") @db.Uuid
  quantidade Decimal  @default(0) @db.Decimal(12, 3)
  custoMedio Decimal  @default(0) @map("custo_medio") @db.Decimal(12, 4)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  produto Produto      @relation("SaldoProduto", fields: [produtoId], references: [id], onDelete: Cascade)
  local   EstoqueLocal @relation(fields: [localId], references: [id], onDelete: Restrict)

  @@unique([produtoId, localId])
  @@index([localId])
  @@map("estoque_saldos")
}

// ─── 8.7 Financeiro ───────────────────────────────────────────────────────────

enum TipoFormaPagamento {
  dinheiro
  pix
  cartao_debito
  cartao_credito
  boleto
  transferencia
  outro

  @@map("tipo_forma_pagamento")
}

enum TipoContaFinanceira {
  caixa
  banco
  outro

  @@map("tipo_conta_financeira")
}

enum TipoCategoriaFinanceira {
  receita
  despesa

  @@map("tipo_categoria_financeira")
}

enum TipoMovimentoFinanceiro {
  entrada
  saida

  @@map("tipo_movimento_financeiro")
}

model FormaPagamento {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String             @unique
  tipo                TipoFormaPagamento
  /// Taxa da operadora, em % (vira despesa "Taxas de cartão" em cada recebimento)
  taxaPercentual      Decimal            @default(0) @map("taxa_percentual") @db.Decimal(5, 2)
  diasRecebimento     Int                @default(0) @map("dias_recebimento")
  permiteParcelamento Boolean            @default(false) @map("permite_parcelamento")
  maxParcelas         Int                @default(1) @map("max_parcelas")
  /// Conta que recebe o dinheiro (sem ela: a conta escolhida na baixa ou a do caixa)
  contaFinanceiraId   String?            @map("conta_financeira_id") @db.Uuid
  ativo               Boolean            @default(true)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy           String?            @map("created_by") @db.Uuid

  contaFinanceira ContaFinanceira?      @relation(fields: [contaFinanceiraId], references: [id], onDelete: SetNull)
  contasReceber   ContaReceber[]
  contasPagar     ContaPagar[]
  movimentos      MovimentoFinanceiro[]
  caixaMovimentos CaixaMovimento[]

  @@map("formas_pagamento")
}

model ContaFinanceira {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String              @unique
  tipo         TipoContaFinanceira
  banco        String?
  agencia      String?
  numeroConta  String?             @map("numero_conta")
  saldoInicial Decimal             @default(0) @map("saldo_inicial") @db.Decimal(14, 2)
  ativo        Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    String?             @map("created_by") @db.Uuid

  formas        FormaPagamento[]
  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]
  movimentos    MovimentoFinanceiro[]
  caixaSessoes  CaixaSessao[]

  @@map("contas_financeiras")
}

model CategoriaFinanceira {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  tipo      TipoCategoriaFinanceira
  paiId     String?                 @map("pai_id") @db.Uuid
  /// Categorias usadas pelo sistema (vendas, vendas_balcao, taxas_cartao, comissoes…)
  codigo    String?                 @unique
  ativo     Boolean                 @default(true)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  pai           CategoriaFinanceira?  @relation("CategoriaFinanceiraPai", fields: [paiId], references: [id], onDelete: Restrict)
  filhas        CategoriaFinanceira[] @relation("CategoriaFinanceiraPai")
  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]
  movimentos    MovimentoFinanceiro[]

  @@index([tipo])
  @@map("categorias_financeiras")
}

model ContaPagar {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fornecedorId       String?     @map("fornecedor_id") @db.Uuid
  descricao          String
  documento          String?
  parcela            Int         @default(1)
  totalParcelas      Int         @default(1) @map("total_parcelas")
  valor              Decimal     @db.Decimal(12, 2)
  vencimento         DateTime    @db.Date
  status             StatusConta @default(aberto)
  valorPago          Decimal     @default(0) @map("valor_pago") @db.Decimal(12, 2)
  juros              Decimal     @default(0) @db.Decimal(12, 2)
  multa              Decimal     @default(0) @db.Decimal(12, 2)
  desconto           Decimal     @default(0) @db.Decimal(12, 2)
  pagoEm             DateTime?   @map("pago_em") @db.Date
  formaPagamentoId   String?     @map("forma_pagamento_id") @db.Uuid
  contaFinanceiraId  String?     @map("conta_financeira_id") @db.Uuid
  categoriaId        String?     @map("categoria_id") @db.Uuid
  anexoId            String?     @map("anexo_id") @db.Uuid
  observacao         String?
  motivoCancelamento String?     @map("motivo_cancelamento")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?     @map("created_by") @db.Uuid

  fornecedor      Fornecedor?           @relation("ContaPagarFornecedor", fields: [fornecedorId], references: [id], onDelete: Restrict)
  formaPagamento  FormaPagamento?       @relation(fields: [formaPagamentoId], references: [id], onDelete: SetNull)
  contaFinanceira ContaFinanceira?      @relation(fields: [contaFinanceiraId], references: [id], onDelete: SetNull)
  categoria       CategoriaFinanceira?  @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  anexo           Arquivo?              @relation("ContaPagarAnexo", fields: [anexoId], references: [id], onDelete: SetNull)
  movimentos      MovimentoFinanceiro[]

  @@index([fornecedorId])
  @@index([status])
  @@index([vencimento])
  @@map("contas_pagar")
}

/// Extrato realizado (base do fluxo de caixa). Valor sempre positivo; o tipo diz se entrou ou saiu.
model MovimentoFinanceiro {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo              TipoMovimentoFinanceiro
  valor             Decimal                 @db.Decimal(14, 2)
  data              DateTime                @db.Date
  descricao         String
  contaFinanceiraId String                  @map("conta_financeira_id") @db.Uuid
  categoriaId       String?                 @map("categoria_id") @db.Uuid
  formaPagamentoId  String?                 @map("forma_pagamento_id") @db.Uuid
  contaReceberId    String?                 @map("conta_receber_id") @db.Uuid
  contaPagarId      String?                 @map("conta_pagar_id") @db.Uuid
  comissaoId        String?                 @map("comissao_id") @db.Uuid
  caixaSessaoId     String?                 @map("caixa_sessao_id") @db.Uuid
  vendaPdvId        String?                 @map("venda_pdv_id") @db.Uuid
  /// Pernas de uma transferência entre contas (sangria/suprimento): fora de receitas e despesas
  transferenciaId   String?                 @map("transferencia_id") @db.Uuid
  /// Detalhe da baixa: principal abatido do título, juros, multa e desconto
  principal         Decimal?                @db.Decimal(12, 2)
  juros             Decimal                 @default(0) @db.Decimal(12, 2)
  multa             Decimal                 @default(0) @db.Decimal(12, 2)
  desconto          Decimal                 @default(0) @db.Decimal(12, 2)
  /// Estorno: aponta para o movimento desfeito
  /// Taxa de cartão: aponta para o movimento da baixa/venda que a gerou (estorna junto)
  baixaDeId         String?                 @map("baixa_de_id") @db.Uuid
  estornoDeId       String?                 @unique @map("estorno_de_id") @db.Uuid
  usuarioId         String?                 @map("usuario_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  contaFinanceira ContaFinanceira       @relation(fields: [contaFinanceiraId], references: [id], onDelete: Restrict)
  categoria       CategoriaFinanceira?  @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  formaPagamento  FormaPagamento?       @relation(fields: [formaPagamentoId], references: [id], onDelete: SetNull)
  contaReceber    ContaReceber?         @relation(fields: [contaReceberId], references: [id], onDelete: Restrict)
  contaPagar      ContaPagar?           @relation(fields: [contaPagarId], references: [id], onDelete: Restrict)
  comissao        Comissao?             @relation(fields: [comissaoId], references: [id], onDelete: Restrict)
  caixaSessao     CaixaSessao?          @relation(fields: [caixaSessaoId], references: [id], onDelete: Restrict)
  vendaPdv        VendaPdv?             @relation(fields: [vendaPdvId], references: [id], onDelete: Restrict)
  baixaDe         MovimentoFinanceiro?  @relation("TaxaDaBaixa", fields: [baixaDeId], references: [id], onDelete: Restrict)
  taxas           MovimentoFinanceiro[] @relation("TaxaDaBaixa")
  estornoDe       MovimentoFinanceiro?  @relation("EstornoMovimento", fields: [estornoDeId], references: [id], onDelete: Restrict)
  estornadoPor    MovimentoFinanceiro?  @relation("EstornoMovimento")
  usuario         Usuario?              @relation("MovimentoFinanceiroUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  caixaMovimentos CaixaMovimento[]

  @@index([data])
  @@index([contaFinanceiraId, data])
  @@index([contaReceberId])
  @@index([contaPagarId])
  @@index([categoriaId])
  @@map("movimentos_financeiros")
}

// ─── 8.8 Caixa / PDV ─────────────────────────────────────────────────────────

enum StatusCaixaSessao {
  aberta
  fechada

  @@map("status_caixa_sessao")
}

enum TipoCaixaMovimento {
  abertura
  venda
  recebimento
  sangria
  suprimento
  estorno

  @@map("tipo_caixa_movimento")
}

enum StatusVendaPdv {
  concluida
  cancelada

  @@map("status_venda_pdv")
}

model CaixaSessao {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero            String            @unique
  usuarioId         String            @map("usuario_id") @db.Uuid
  contaFinanceiraId String            @map("conta_financeira_id") @db.Uuid
  status            StatusCaixaSessao @default(aberta)
  abertaEm          DateTime          @default(now()) @map("aberta_em") @db.Timestamptz(3)
  valorAbertura     Decimal           @default(0) @map("valor_abertura") @db.Decimal(12, 2)
  fechadaEm         DateTime?         @map("fechada_em") @db.Timestamptz(3)
  fechadaPorId      String?           @map("fechada_por_id") @db.Uuid
  totalCalculado    Decimal?          @map("total_calculado") @db.Decimal(12, 2)
  totalInformado    Decimal?          @map("total_informado") @db.Decimal(12, 2)
  diferenca         Decimal?          @db.Decimal(12, 2)
  /// Conferência do fechamento por forma: [{ formaPagamentoId, nome, calculado, informado, diferenca }]
  conferencia       Json?
  observacao        String?

  usuario         Usuario               @relation("CaixaSessaoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  fechadaPor      Usuario?              @relation("CaixaSessaoFechadaPor", fields: [fechadaPorId], references: [id], onDelete: SetNull)
  contaFinanceira ContaFinanceira       @relation(fields: [contaFinanceiraId], references: [id], onDelete: Restrict)
  movimentos      CaixaMovimento[]
  vendas          VendaPdv[]
  financeiros     MovimentoFinanceiro[]

  @@index([usuarioId, status])
  @@index([abertaEm])
  @@map("caixa_sessoes")
}

/// Movimentos da gaveta. Valor com sinal: positivo entra no caixa, negativo sai (sangria, estorno).
model CaixaMovimento {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessaoId              String             @map("sessao_id") @db.Uuid
  tipo                  TipoCaixaMovimento
  formaPagamentoId      String?            @map("forma_pagamento_id") @db.Uuid
  valor                 Decimal            @db.Decimal(12, 2)
  motivo                String?
  vendaPdvId            String?            @map("venda_pdv_id") @db.Uuid
  contaReceberId        String?            @map("conta_receber_id") @db.Uuid
  movimentoFinanceiroId String?            @map("movimento_financeiro_id") @db.Uuid
  usuarioId             String?            @map("usuario_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  sessao              CaixaSessao          @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  formaPagamento      FormaPagamento?      @relation(fields: [formaPagamentoId], references: [id], onDelete: SetNull)
  vendaPdv            VendaPdv?            @relation(fields: [vendaPdvId], references: [id], onDelete: Restrict)
  contaReceber        ContaReceber?        @relation(fields: [contaReceberId], references: [id], onDelete: Restrict)
  movimentoFinanceiro MovimentoFinanceiro? @relation(fields: [movimentoFinanceiroId], references: [id], onDelete: SetNull)
  usuario             Usuario?             @relation("CaixaMovimentoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([sessaoId])
  @@map("caixa_movimentos")
}

model VendaPdv {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero             String         @unique
  sessaoId           String         @map("sessao_id") @db.Uuid
  clienteId          String?        @map("cliente_id") @db.Uuid
  usuarioId          String?        @map("usuario_id") @db.Uuid
  subtotal           Decimal        @db.Decimal(12, 2)
  desconto           Decimal        @default(0) @db.Decimal(12, 2)
  total              Decimal        @db.Decimal(12, 2)
  valorRecebido      Decimal        @map("valor_recebido") @db.Decimal(12, 2)
  troco              Decimal        @default(0) @db.Decimal(12, 2)
  status             StatusVendaPdv @default(concluida)
  motivoCancelamento String?        @map("motivo_cancelamento")
  canceladaEm        DateTime?      @map("cancelada_em") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  sessao            CaixaSessao           @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  cliente           Cliente?              @relation("VendaPdvCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  usuario           Usuario?              @relation("VendaPdvUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  itens             VendaPdvItem[]
  caixaMovimentos   CaixaMovimento[]
  movimentos        MovimentoFinanceiro[]
  movimentosEstoque EstoqueMovimentacao[]

  @@index([sessaoId])
  @@index([createdAt])
  @@map("vendas_pdv")
}

model VendaPdvItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendaId       String  @map("venda_id") @db.Uuid
  produtoId     String  @map("produto_id") @db.Uuid
  descricao     String
  quantidade    Decimal @db.Decimal(12, 3)
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  /// Custo direto da venda (materiais da composição/ficha ou custo do produto), para os relatórios
  custo         Decimal? @db.Decimal(12, 2)

  venda   VendaPdv @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto  @relation("VendaPdvItemProduto", fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([vendaId])
  @@map("vendas_pdv_itens")
}

// ─── Plataforma: empresas assinantes e índice de login ──────────────────────
// Usadas só no schema "plataforma". Cada empresa tem o próprio schema com as demais tabelas;
// como todos os schemas recebem as mesmas migrations, estas tabelas também existem (vazias) neles.

model Assinante {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  /**
   * Identificador curto e fixo, usado nos links públicos (/aprovar/{slug}/{token})
   */
  slug      String   @unique
  /**
   * Schema do PostgreSQL com os dados da empresa
   */
  schema    String   @unique
  email     String?
  cnpj      String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  logins       IndiceLogin[]
  tokensSenha  TokenSenha[]
  assinatura   Assinatura?
  eventos      EventoAssinatura[]
  cobrancas    Cobranca[]
  cuponsUsados CupomUso[]

  @@map("assinantes")
}

/**
 * E-mail de login → empresa: o e-mail é único em toda a plataforma.
 */
model IndiceLogin {
  email       String   @id
  assinanteId String   @map("assinante_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assinante Assinante @relation(fields: [assinanteId], references: [id], onDelete: Cascade)

  @@index([assinanteId])
  @@map("indice_login")
}

/**
 * Link de senha enviado por e-mail ("esqueci a senha" ou convite de usuário novo).
 * Fica na plataforma porque o link chega sem login: o token diz a empresa e o usuário.
 * Só o hash é gravado; o link vale uma vez e até expirar.
 */
model TokenSenha {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  assinanteId String    @map("assinante_id") @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  /**
   * redefinir | convite
   */
  finalidade  String
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(3)
  usadoEm     DateTime? @map("usado_em") @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  assinante Assinante @relation(fields: [assinanteId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_senha")
}

/**
 * Plano vendido: módulos liberados, limite de usuários, teste grátis e prazos do bloqueio.
 */
model Plano {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                String   @unique
  nome                  String
  descricao             String?
  valorMensal           Decimal  @map("valor_mensal") @db.Decimal(10, 2)
  /**
   * Códigos de módulo (MODULOS); os essenciais entram sempre
   */
  modulos               String[]
  /**
   * null = sem limite
   */
  limiteUsuarios        Int?     @map("limite_usuarios")
  diasTeste             Int      @default(14) @map("dias_teste")
  /**
   * Dias de atraso até o sistema ficar só para consulta
   */
  diasAteSomenteLeitura Int      @default(5) @map("dias_ate_somente_leitura")
  /**
   * Dias de atraso até o bloqueio total
   */
  diasAteBloqueio       Int      @default(15) @map("dias_ate_bloqueio")
  /**
   * Aparece na página de cadastro e na troca de plano
   */
  publico               Boolean  @default(true)
  ativo                 Boolean  @default(true)
  ordem                 Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assinaturas Assinatura[]

  @@map("planos")
}

/**
 * Assinatura de uma empresa (uma por empresa). O nível de acesso é calculado (calcularAcesso).
 */
model Assinatura {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assinanteId          String    @unique @map("assinante_id") @db.Uuid
  planoId              String    @map("plano_id") @db.Uuid
  /**
   * teste | ativa | cortesia | cancelada
   */
  situacao             String    @default("teste")
  testeAte             DateTime? @map("teste_ate") @db.Date
  /// Cortesia (assinatura grátis): até esta data (null = sem prazo) e o motivo
  cortesiaAte          DateTime? @map("cortesia_ate") @db.Date
  cortesiaMotivo       String?   @map("cortesia_motivo")
  /**
   * Vencimento da cobrança mais antiga ainda não paga (null = em dia)
   */
  atrasoDesde          DateTime? @map("atraso_desde") @db.Date
  proximoVencimento    DateTime? @map("proximo_vencimento") @db.Date
  /**
   * Liberação manual: acesso normal até esta data, mesmo com atraso
   */
  liberadoAte          DateTime? @map("liberado_ate") @db.Date
  bloqueioManual       Boolean   @default(false) @map("bloqueio_manual")
  motivoBloqueio       String?   @map("motivo_bloqueio")
  /**
   * Módulos contratados além dos do plano
   */
  modulosExtras        String[]  @default([]) @map("modulos_extras")
  canceladaEm          DateTime? @map("cancelada_em") @db.Timestamptz(3)
  /**
   * Cancelamento pedido pela empresa: vale a partir desta data (fim do período pago)
   */
  cancelarEm           DateTime? @map("cancelar_em") @db.Date
  /**
   * asaas | manual (sem gateway: o suporte registra as cobranças)
   */
  gateway              String    @default("manual")
  gatewayClienteId     String?   @map("gateway_cliente_id")
  gatewayAssinaturaId  String?   @unique @map("gateway_assinatura_id")
  /**
   * pix_automatico (débito autorizado no banco) | cartao (cobrança automática) | pix_boleto (paga a cada mês)
   */
  formaPagamento       String?   @map("forma_pagamento")
  /**
   * CPF/CNPJ usado na cobrança e na nota fiscal
   */
  documentoCobranca    String?   @map("documento_cobranca")
  /// Downgrade: o plano maior já pago vale até o fim do período; este passa a valer em planoAgendadoEm
  planoAgendadoId      String?   @map("plano_agendado_id") @db.Uuid
  planoAgendadoEm      DateTime? @map("plano_agendado_em") @db.Date
  /// PIX Automático: autorização no Asaas (vira assinatura quando o pagador autoriza no banco)
  gatewayAutorizacaoId String?   @unique @map("gateway_autorizacao_id")
  /// QR Code da autorização + 1ª mensalidade (copia e cola e imagem em base64), enquanto aguarda
  pixQrPayload         String?   @map("pix_qr_payload")
  pixQrImagem          String?   @map("pix_qr_imagem")
  pixQrExpiraEm        DateTime? @map("pix_qr_expira_em") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  assinante Assinante @relation(fields: [assinanteId], references: [id], onDelete: Cascade)
  plano     Plano     @relation(fields: [planoId], references: [id], onDelete: Restrict)

  @@index([planoId])
  @@map("assinaturas")
}

/**
 * Histórico da assinatura (troca de plano, liberação, bloqueio, pagamentos…), para o suporte.
 */
model EventoAssinatura {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assinanteId String   @map("assinante_id") @db.Uuid
  tipo        String
  descricao   String
  dados       Json?
  /**
   * Quem fez: "sistema", "cli", e-mail do suporte…
   */
  autor       String   @default("sistema")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assinante Assinante @relation(fields: [assinanteId], references: [id], onDelete: Cascade)

  @@index([assinanteId, createdAt])
  @@map("eventos_assinatura")
}

/**
 * Mensalidade da assinatura (do Asaas ou lançada pelo suporte no modo manual).
 */
model Cobranca {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assinanteId        String    @map("assinante_id") @db.Uuid
  gateway            String
  /**
   * Id da cobrança no gateway (pay_…); vazio no modo manual
   */
  gatewayId          String?   @unique @map("gateway_id")
  valor              Decimal   @db.Decimal(10, 2)
  /// mensalidade | proporcional (diferença de upgrade no meio do período)
  tipo               String    @default("mensalidade")
  descricao          String?
  vencimento         DateTime  @db.Date
  /// Vencimento original quando a cobrança precisou de data nova no gateway (ele não aceita data passada): o atraso conta dele
  vencimentoOriginal DateTime? @map("vencimento_original") @db.Date
  /**
   * pendente | paga | vencida | cancelada | estornada | abonada (mês grátis ou perdoada pelo suporte)
   */
  situacao           String    @default("pendente")
  /// Desconto de cupom já aplicado em `valor`
  desconto           Decimal?  @db.Decimal(10, 2)
  /// Abonada: por quê (e quem, no histórico)
  motivoAbono        String?   @map("motivo_abono")
  /**
   * PIX, BOLETO, CREDIT_CARD…
   */
  forma              String?
  pagoEm             DateTime? @map("pago_em") @db.Timestamptz(3)
  /**
   * Página de pagamento (fatura do Asaas)
   */
  linkPagamento      String?   @map("link_pagamento")
  /**
   * Última recusa do cartão (para o suporte e o aviso na tela)
   */
  falha              String?
  /**
   * Nota fiscal: agendada | emitida | erro | cancelada
   */
  nfSituacao         String?   @map("nf_situacao")
  nfNumero           String?   @map("nf_numero")
  nfLinkPdf          String?   @map("nf_link_pdf")
  nfErro             String?   @map("nf_erro")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  assinante Assinante @relation(fields: [assinanteId], references: [id], onDelete: Cascade)

  @@index([assinanteId, vencimento])
  @@map("cobrancas")
}

/**
 * Cupom de desconto: digitado no cadastro ou ao assinar, ou aplicado pelo suporte.
 */
model Cupom {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Sempre em maiúsculas
  codigo       String    @unique
  descricao    String?
  /// percentual | valor
  tipo         String
  valor        Decimal   @db.Decimal(10, 2)
  /// Quantas mensalidades têm desconto (null = para sempre)
  duracaoMeses Int?      @map("duracao_meses")
  /// Último dia para usar o cupom (null = sem validade)
  validoAte    DateTime? @map("valido_ate") @db.Date
  limiteUsos   Int?      @map("limite_usos")
  /// Códigos de plano (vazio = todos)
  planos       String[]  @default([])
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  usos CupomUso[]

  @@map("cupons")
}

/**
 * Cupom aplicado numa assinatura: o desconto vale nas mensalidades de `desde` a `ate`. Um em vigor por empresa.
 */
model CupomUso {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cupomId     String    @map("cupom_id") @db.Uuid
  assinanteId String    @map("assinante_id") @db.Uuid
  /// 1ª mensalidade com desconto (null = a 1ª que for gerada, quando assinar)
  desde       DateTime? @db.Date
  /// Última mensalidade com desconto (null = para sempre)
  ate         DateTime? @db.Date
  autor       String    @default("sistema")
  /// Removido pelo suporte ou janela terminada (valor cheio de volta)
  encerradoEm DateTime? @map("encerrado_em") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  cupom     Cupom     @relation(fields: [cupomId], references: [id], onDelete: Restrict)
  assinante Assinante @relation(fields: [assinanteId], references: [id], onDelete: Cascade)

  @@index([assinanteId])
  @@index([cupomId])
  @@map("cupons_usos")
}

/**
 * Aviso recebido do gateway (webhook): guardado antes de processar; o id do evento evita processar duas vezes.
 */
model EventoGateway {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gateway      String
  eventoId     String    @unique @map("evento_id")
  tipo         String
  payload      Json
  recebidoEm   DateTime  @default(now()) @map("recebido_em") @db.Timestamptz(3)
  processadoEm DateTime? @map("processado_em") @db.Timestamptz(3)
  erro         String?

  @@index([recebidoEm])
  @@map("eventos_gateway")
}

/**
 * Administrador da plataforma (dono do sistema / suporte): login próprio, separado dos usuários das empresas.
 */
model AdminPlataforma {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String
  email       String    @unique
  senhaHash   String    @map("senha_hash")
  ativo       Boolean   @default(true)
  ultimoLogin DateTime? @map("ultimo_login") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admins_plataforma")
}
