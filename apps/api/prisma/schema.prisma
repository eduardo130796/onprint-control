// GrafyGo — schema do banco (PostgreSQL 16)
// Modelos em PascalCase mapeados para tabelas/colunas em snake_case (português, sem acento).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 8.1 Núcleo: usuários, sessões e permissões ─────────────────────────────

model Usuario {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome               String
  email              String    @unique
  senhaHash          String    @map("senha_hash")
  telefone           String?
  avatar             String?
  papelId            String    @map("papel_id") @db.Uuid
  comissaoPercentual Decimal   @default(0) @map("comissao_percentual") @db.Decimal(5, 2)
  deveTrocarSenha    Boolean   @default(false) @map("deve_trocar_senha")
  /// Modo da tela: claro | escuro | sistema (preferência de cada usuário)
  modoTela           String    @default("claro") @map("modo_tela")
  /// Fonte do texto: inter | jakarta | lexend | nunito (preferência de cada usuário)
  fonte              String    @default("inter")
  /// Peso do texto: leve | normal | forte
  pesoTexto          String    @default("normal") @map("peso_texto")
  /// Tamanho da interface: compacto | padrao | grande
  escala             String    @default("padrao")
  /// Usuário de painel (TV da produção): não sai por inatividade
  semInatividade     Boolean   @default(false) @map("sem_inatividade")
  ultimoLogin        DateTime? @map("ultimo_login") @db.Timestamptz(3)
  ativo              Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid

  papel   Papel    @relation(fields: [papelId], references: [id], onDelete: Restrict)
  sessoes Sessao[]

  clientesVendedor Cliente[]     @relation("ClienteVendedor")
  arquivosEnviados Arquivo[]
  notificacoes     Notificacao[]

  solicitacoesResponsavel SolicitacaoOrcamento[] @relation("SolicitacaoResponsavel")
  orcamentosVendedor      Orcamento[]            @relation("OrcamentoVendedor")
  precosLiberados         OrcamentoItem[]        @relation("PrecoLiberadoPor")
  pedidosVendedor         Pedido[]               @relation("PedidoVendedor")
  artesDesigner           Arte[]                 @relation("ArteDesigner")
  entregasResponsavel     Entrega[]              @relation("EntregaResponsavel")
  comissoes               Comissao[]             @relation("ComissaoVendedor")
  opsResponsavel          OrdemProducao[]        @relation("OpResponsavel")
  opsHistorico            OpEtapaHistorico[]     @relation("OpHistoricoUsuario")
  apontamentos            OpApontamento[]        @relation("ApontamentoOperador")
  comentariosArte         ArteComentario[]       @relation("ArteComentarioUsuario")
  entradasEstoque         EstoqueEntrada[]       @relation("EntradaUsuario")
  movimentacoesEstoque    EstoqueMovimentacao[]  @relation("MovimentacaoUsuario")
  movimentosFinanceiros   MovimentoFinanceiro[]  @relation("MovimentoFinanceiroUsuario")
  caixaSessoes            CaixaSessao[]          @relation("CaixaSessaoUsuario")
  caixaSessoesFechadas    CaixaSessao[]          @relation("CaixaSessaoFechadaPor")
  caixaMovimentos         CaixaMovimento[]       @relation("CaixaMovimentoUsuario")
  vendasPdv               VendaPdv[]             @relation("VendaPdvUsuario")

  @@index([papelId])
  @@map("usuarios")
}

model Sessao {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId        String   @map("usuario_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  expiraEm         DateTime @map("expira_em") @db.Timestamptz(3)
  ip               String?
  userAgent        String?  @map("user_agent")
  revogada         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

model Papel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String   @unique
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  usuarios   Usuario[]
  permissoes PapelPermissao[]

  @@map("papeis")
}

model Permissao {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modulo    String
  acao      String
  descricao String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  papeis PapelPermissao[]

  @@unique([modulo, acao])
  @@map("permissoes")
}

model PapelPermissao {
  papelId     String   @map("papel_id") @db.Uuid
  permissaoId String   @map("permissao_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid

  papel     Papel     @relation(fields: [papelId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([papelId, permissaoId])
  @@index([permissaoId])
  @@map("papel_permissoes")
}

// ─── 8.1 Núcleo: configuração, status, numeração, auditoria, arquivos ───────

/// Linha única com os dados da empresa e padrões comerciais.
model EmpresaConfig {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razaoSocial           String   @map("razao_social")
  nomeFantasia          String?  @map("nome_fantasia")
  cnpj                  String?
  ie                    String?
  email                 String?
  telefone              String?
  whatsapp              String?
  site                  String?
  cep                   String?
  logradouro            String?
  numero                String?
  complemento           String?
  bairro                String?
  cidade                String?
  uf                    String?  @db.Char(2)
  logoArquivoId         String?  @map("logo_arquivo_id") @db.Uuid
  /// Cor do tema do sistema (paleta TEMAS: verde, azul, roxo…); null = azul GrafyGo
  corTema               String?  @map("cor_tema")
  /// Minutos sem uso até o sistema sair sozinho (15, 30, 60, 120 ou 240)
  inatividadeMinutos    Int      @default(30) @map("inatividade_minutos")
  validadeOrcamentoDias Int      @default(7) @map("validade_orcamento_dias")
  condicoesPadrao       String?  @map("condicoes_padrao")
  sinalPercentual       Decimal  @default(50) @map("sinal_percentual") @db.Decimal(5, 2)
  chavePix              String?  @map("chave_pix")
  areaMinimaM2          Decimal  @default(0) @map("area_minima_m2") @db.Decimal(10, 3)
  /// Precificação: percentuais sobre o preço, rateio dos custos fixos e lucro padrão (docs/PRECIFICACAO.md)
  impostosPercentual    Decimal  @default(0) @map("impostos_percentual") @db.Decimal(5, 2)
  comissaoPercentual    Decimal  @default(0) @map("comissao_percentual") @db.Decimal(5, 2)
  custoFixoPercentual   Decimal  @default(0) @map("custo_fixo_percentual") @db.Decimal(5, 2)
  /// nenhum | percentual | por_hora
  rateioModo            String   @default("nenhum") @map("rateio_modo")
  custoFixoMensal       Decimal  @default(0) @map("custo_fixo_mensal") @db.Decimal(12, 2)
  horasProdutivasMes    Int      @default(0) @map("horas_produtivas_mes")
  lucroDesejadoPadrao   Decimal  @default(30) @map("lucro_desejado_padrao") @db.Decimal(5, 2)
  lucroMinimoPadrao     Decimal  @default(15) @map("lucro_minimo_padrao") @db.Decimal(5, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy             String?  @map("created_by") @db.Uuid

  logo Arquivo? @relation(fields: [logoArquivoId], references: [id], onDelete: SetNull)

  @@map("empresa_config")
}

model StatusConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidade  String
  codigo    String
  rotulo    String
  cor       String   @db.VarChar(7)
  ordem     Int      @default(0)
  ehFinal   Boolean  @default(false) @map("eh_final")
  /// false = status próprio criado pelo usuário (pode ser excluído)
  sistema   Boolean  @default(true)
  /// Status próprio: código do status do sistema que ele "conta como" (as regras automáticas usam a base)
  base      String?
  /// false = oculto (a coluna some do kanban quando está vazia)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedidos    Pedido[]        @relation("PedidoStatusPersonalizado")
  orcamentos Orcamento[]     @relation("OrcamentoStatusPersonalizado")
  ops        OrdemProducao[] @relation("OpEtapaPersonalizada")

  @@unique([entidade, codigo])
  @@map("status_config")
}

/// Sequência por entidade e ano (ORC-2026-0001). Incrementada com SELECT ... FOR UPDATE.
model Numeracao {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidade     String
  prefixo      String
  ano          Int
  ultimoNumero Int      @default(0) @map("ultimo_numero")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([entidade, ano])
  @@map("numeracao")
}

model Auditoria {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tabela     String
  registroId String?  @map("registro_id")
  acao       String
  antes      Json?
  depois     Json?
  usuarioId  String?  @map("usuario_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tabela, registroId])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("auditoria")
}

model Arquivo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidade     String
  entidadeId   String?  @map("entidade_id") @db.Uuid
  categoria    String
  nomeOriginal String   @map("nome_original")
  caminho      String   @unique
  mime         String
  tamanho      Int
  enviadoPorId String?  @map("enviado_por") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  enviadoPor          Usuario?        @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)
  empresaLogoDe       EmpresaConfig[]
  produtosImagem      Produto[]
  artesArquivo        Arte[]          @relation("ArteArquivo")
  artesMiniatura      Arte[]          @relation("ArteMiniatura")
  comprovantesEntrega Entrega[]       @relation("EntregaComprovante")
  contasPagar         ContaPagar[]    @relation("ContaPagarAnexo")
  contasReceber       ContaReceber[]  @relation("ContaReceberAnexo")

  @@index([entidade, entidadeId])
  @@map("arquivos")
}

model Notificacao {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

model MensagemTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  categoria String
  conteudo  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  @@index([categoria])
  @@map("mensagem_templates")
}

// ─── 8.2 Pessoas ────────────────────────────────────────────────────────────

enum TipoPessoa {
  PF
  PJ

  @@map("tipo_pessoa")
}

enum SituacaoCliente {
  pre_cadastro
  ativo
  inativo
  bloqueado

  @@map("situacao_cliente")
}

enum TipoEndereco {
  principal
  entrega
  cobranca

  @@map("tipo_endereco")
}

model Cliente {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipoPessoa    TipoPessoa      @default(PF) @map("tipo_pessoa")
  nome          String
  fantasia      String?
  cpfCnpj       String?         @unique @map("cpf_cnpj")
  ie            String?
  email         String?
  telefone      String?
  whatsapp      String?         @unique
  origem        String?
  situacao      SituacaoCliente @default(pre_cadastro)
  limiteCredito Decimal         @default(0) @map("limite_credito") @db.Decimal(12, 2)
  vendedorId    String?         @map("vendedor_id") @db.Uuid
  observacoes   String?
  tags          String[]        @default([])
  ativo         Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String?         @map("created_by") @db.Uuid

  vendedor      Usuario?               @relation("ClienteVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  enderecos     ClienteEndereco[]
  contatos      ClienteContato[]
  solicitacoes  SolicitacaoOrcamento[]
  orcamentos    Orcamento[]
  pedidos       Pedido[]
  contasReceber ContaReceber[]
  vendasPdv     VendaPdv[]             @relation("VendaPdvCliente")

  @@index([situacao])
  @@index([vendedorId])
  @@index([nome])
  @@map("clientes")
}

model ClienteEndereco {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId   String       @map("cliente_id") @db.Uuid
  tipo        TipoEndereco @default(principal)
  cep         String?
  logradouro  String
  numero      String?
  complemento String?
  bairro      String?
  cidade      String
  uf          String       @db.Char(2)
  referencia  String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?      @map("created_by") @db.Uuid

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("cliente_enderecos")
}

model ClienteContato {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  nome      String
  cargo     String?
  email     String?
  telefone  String?
  whatsapp  String?
  principal Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("cliente_contatos")
}

model Fornecedor {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipoPessoa            TipoPessoa            @default(PJ) @map("tipo_pessoa")
  nome                  String
  fantasia              String?
  cpfCnpj               String?               @unique @map("cpf_cnpj")
  ie                    String?
  email                 String?
  telefone              String?
  whatsapp              String?
  contato               String?
  categoriaFornecimento String?               @map("categoria_fornecimento")
  prazoMedioDias        Int?                  @map("prazo_medio_dias")
  condicoesPagamento    String?               @map("condicoes_pagamento")
  cep                   String?
  logradouro            String?
  numero                String?
  complemento           String?
  bairro                String?
  cidade                String?
  uf                    String?               @db.Char(2)
  observacoes           String?
  ativo                 Boolean               @default(true)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy             String?               @map("created_by") @db.Uuid
  entradasEstoque       EstoqueEntrada[]      @relation("EntradaFornecedor")
  movimentacoesEstoque  EstoqueMovimentacao[] @relation("MovimentacaoFornecedor")
  contasPagar           ContaPagar[]          @relation("ContaPagarFornecedor")
  insumosPreferidos     Produto[]             @relation("InsumoFornecedorPreferido")

  @@index([nome])
  @@map("fornecedores")
}

// ─── 8.3 Produtos ───────────────────────────────────────────────────────────

enum TipoProduto {
  produto
  servico
  insumo
  revenda

  @@map("tipo_produto")
}

enum ModoCalculo {
  unidade
  m2
  metro_linear
  milheiro
  hora

  @@map("modo_calculo")
}

enum TipoCobranca {
  fixo
  por_unidade
  por_m2
  por_metro_linear
  por_perimetro

  @@map("tipo_cobranca")
}

enum StatusMaquina {
  ativa
  manutencao
  parada

  @@map("status_maquina")
}

enum BaseInsumo {
  por_unidade
  por_m2
  por_metro_linear

  @@map("base_insumo")
}

model UnidadeMedida {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sigla     String   @unique
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  produtos Produto[]

  @@map("unidades_medida")
}

model Categoria {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  paiId     String?  @map("pai_id") @db.Uuid
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  pai      Categoria?  @relation("CategoriaPai", fields: [paiId], references: [id], onDelete: Restrict)
  filhas   Categoria[] @relation("CategoriaPai")
  produtos Produto[]

  @@index([paiId])
  @@map("categorias")
}

model Produto {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                String      @unique
  nome                  String
  descricao             String?
  categoriaId           String?     @map("categoria_id") @db.Uuid
  unidadeMedidaId       String?     @map("unidade_medida_id") @db.Uuid
  tipo                  TipoProduto @default(produto)
  modoCalculo           ModoCalculo @default(unidade) @map("modo_calculo")
  precoVenda            Decimal     @default(0) @map("preco_venda") @db.Decimal(12, 2)
  /// Custo por unidade de cálculo (insumo: por unidade de uso); na composição, calculado
  custo                 Decimal     @default(0) @db.Decimal(12, 4)
  /// Legado: markup sobre o custo, em % (substituído por lucroDesejado)
  margem                Decimal     @default(0) @db.Decimal(7, 2)
  precoMinimo           Decimal?    @map("preco_minimo") @db.Decimal(12, 2)
  /// simples (custo digitado) | composicao (materiais + produção + extras)
  modoCusto             String      @default("simples") @map("modo_custo")
  /// % sobre o preço; null = padrão da empresa
  lucroDesejado         Decimal?    @map("lucro_desejado") @db.Decimal(5, 2)
  lucroMinimo           Decimal?    @map("lucro_minimo") @db.Decimal(5, 2)
  /// Detalhamento do custo de referência (CustoItem) gravado no recálculo
  custoDetalhe          Json?       @map("custo_detalhe")
  custoCalculadoEm      DateTime?   @map("custo_calculado_em") @db.Timestamptz(3)
  /// Insumo: como é comprado (rolo, chapa, pacote, caixa, galao, unidade)
  embalagem             String?     @map("embalagem")
  embalagemLargura      Decimal?    @map("embalagem_largura") @db.Decimal(12, 3)
  embalagemComprimento  Decimal?    @map("embalagem_comprimento") @db.Decimal(12, 3)
  embalagemConteudo     Decimal?    @map("embalagem_conteudo") @db.Decimal(12, 3)
  precoEmbalagem        Decimal?    @map("preco_embalagem") @db.Decimal(12, 2)
  fornecedorPreferidoId String?     @map("fornecedor_preferido_id") @db.Uuid
  larguraPadrao         Decimal?    @map("largura_padrao") @db.Decimal(10, 3)
  alturaPadrao          Decimal?    @map("altura_padrao") @db.Decimal(10, 3)
  larguraMaxima         Decimal?    @map("largura_maxima") @db.Decimal(10, 3)
  alturaMaxima          Decimal?    @map("altura_maxima") @db.Decimal(10, 3)
  prazoProducaoDias     Int         @default(0) @map("prazo_producao_dias")
  controlaEstoque       Boolean     @default(false) @map("controla_estoque")
  estoqueMinimo         Decimal     @default(0) @map("estoque_minimo") @db.Decimal(12, 3)
  imagemArquivoId       String?     @map("imagem_arquivo_id") @db.Uuid
  ativo                 Boolean     @default(true)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy             String?     @map("created_by") @db.Uuid

  categoria            Categoria?            @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  unidadeMedida        UnidadeMedida?        @relation(fields: [unidadeMedidaId], references: [id], onDelete: Restrict)
  imagem               Arquivo?              @relation(fields: [imagemArquivoId], references: [id], onDelete: SetNull)
  fornecedorPreferido  Fornecedor?           @relation("InsumoFornecedorPreferido", fields: [fornecedorPreferidoId], references: [id], onDelete: SetNull)
  custosExtras         ProdutoCustoExtra[]
  acabamentos          ProdutoAcabamento[]
  insumos              ProdutoInsumo[]       @relation("FichaTecnica")
  usadoComo            ProdutoInsumo[]       @relation("InsumoDaFicha")
  usadoEmAcabamentos   AcabamentoInsumo[]    @relation("InsumoDoAcabamento")
  processos            ProdutoProcesso[]
  orcamentoItens       OrcamentoItem[]       @relation("OrcamentoItemProduto")
  pedidoItens          PedidoItem[]          @relation("PedidoItemProduto")
  entradaItens         EstoqueEntradaItem[]  @relation("EntradaItemProduto")
  movimentacoesEstoque EstoqueMovimentacao[] @relation("MovimentacaoProduto")
  saldosEstoque        EstoqueSaldo[]        @relation("SaldoProduto")
  vendaPdvItens        VendaPdvItem[]        @relation("VendaPdvItemProduto")

  @@index([categoriaId])
  @@index([tipo])
  @@index([nome])
  @@index([fornecedorPreferidoId])
  @@map("produtos")
}

/// Insumos que o acabamento consome (ilhós, bastão, fita…), por unidade da cobrança do acabamento
model AcabamentoInsumo {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acabamentoId    String  @map("acabamento_id") @db.Uuid
  insumoId        String  @map("insumo_id") @db.Uuid
  /// Por unidade da cobrança do acabamento (peça, m², metro, perímetro)
  quantidade      Decimal @db.Decimal(12, 4)
  perdaPercentual Decimal @default(0) @map("perda_percentual") @db.Decimal(5, 2)
  ordem           Int     @default(0)

  acabamento Acabamento @relation(fields: [acabamentoId], references: [id], onDelete: Cascade)
  insumo     Produto    @relation("InsumoDoAcabamento", fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([acabamentoId, insumoId])
  @@index([insumoId])
  @@map("acabamento_insumos")
}

/// Outros custos da composição (embalagem, frete…): valor por unidade, m², metro ou item.
model ProdutoCustoExtra {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId String  @map("produto_id") @db.Uuid
  nome      String
  valor     Decimal @db.Decimal(12, 4)
  /// por_unidade | por_m2 | por_metro_linear | por_item
  base      String  @default("por_item")
  ordem     Int     @default(0)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@map("produto_custos_extras")
}

/// Ficha técnica: insumos consumidos por peça, m² ou metro do produto.
model ProdutoInsumo {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId       String     @map("produto_id") @db.Uuid
  insumoId        String     @map("insumo_id") @db.Uuid
  quantidade      Decimal    @db.Decimal(12, 4)
  base            BaseInsumo @default(por_unidade)
  perdaPercentual Decimal    @default(0) @map("perda_percentual") @db.Decimal(5, 2)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  produto Produto @relation("FichaTecnica", fields: [produtoId], references: [id], onDelete: Cascade)
  insumo  Produto @relation("InsumoDaFicha", fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([produtoId, insumoId])
  @@index([insumoId])
  @@map("produto_insumos")
}

model Acabamento {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome               String
  descricao          String?
  tipoCobranca       TipoCobranca @map("tipo_cobranca")
  valor              Decimal      @db.Decimal(12, 2)
  custo              Decimal      @default(0) @db.Decimal(12, 2)
  prazoAdicionalDias Int          @default(0) @map("prazo_adicional_dias")
  ativo              Boolean      @default(true)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?      @map("created_by") @db.Uuid

  produtos       ProdutoAcabamento[]
  orcamentoItens OrcamentoItemAcabamento[] @relation("OrcamentoItemAcabamento")
  pedidoItens    PedidoItemAcabamento[]    @relation("PedidoItemAcabamento")
  insumos        AcabamentoInsumo[]

  @@index([nome])
  @@map("acabamentos")
}

model ProdutoAcabamento {
  produtoId    String   @map("produto_id") @db.Uuid
  acabamentoId String   @map("acabamento_id") @db.Uuid
  obrigatorio  Boolean  @default(false)
  padrao       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  produto    Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  acabamento Acabamento @relation(fields: [acabamentoId], references: [id], onDelete: Restrict)

  @@id([produtoId, acabamentoId])
  @@index([acabamentoId])
  @@map("produto_acabamentos")
}

model Maquina {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String
  tipo             String?
  larguraUtil      Decimal?      @map("largura_util") @db.Decimal(10, 3)
  velocidadeM2Hora Decimal?      @map("velocidade_m2_hora") @db.Decimal(10, 2)
  custoHora        Decimal       @default(0) @map("custo_hora") @db.Decimal(12, 2)
  status           StatusMaquina @default(ativa)
  observacoes      String?
  ativo            Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String?       @map("created_by") @db.Uuid

  processosPadrao  Processo[]
  produtoProcessos ProdutoProcesso[]
  ordensProducao   OrdemProducao[]   @relation("OpMaquina")
  apontamentos     OpApontamento[]   @relation("ApontamentoMaquina")

  @@index([status])
  @@map("maquinas")
}

model Processo {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome               String
  descricao          String?
  maquinaPadraoId    String?  @map("maquina_padrao_id") @db.Uuid
  tempoPadraoMinutos Int?     @map("tempo_padrao_minutos")
  /// Mão de obra sem máquina (vale quando a máquina não tem custo/hora)
  custoHora          Decimal  @default(0) @map("custo_hora") @db.Decimal(12, 2)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?  @map("created_by") @db.Uuid

  maquinaPadrao Maquina?          @relation(fields: [maquinaPadraoId], references: [id], onDelete: SetNull)
  produtos      ProdutoProcesso[]
  apontamentos  OpApontamento[]   @relation("ApontamentoProcesso")

  @@index([maquinaPadraoId])
  @@map("processos")
}

model ProdutoProcesso {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId    String   @map("produto_id") @db.Uuid
  processoId   String   @map("processo_id") @db.Uuid
  maquinaId    String?  @map("maquina_id") @db.Uuid
  ordem        Int
  /// Minutos por base; null = velocidade da máquina (por m²) ou tempo padrão do processo
  minutos      Decimal? @db.Decimal(10, 2)
  /// por_unidade | por_m2 | por_metro_linear | por_item
  base         String   @default("por_unidade")
  setupMinutos Decimal  @default(0) @map("setup_minutos") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  produto  Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  processo Processo @relation(fields: [processoId], references: [id], onDelete: Restrict)
  maquina  Maquina? @relation(fields: [maquinaId], references: [id], onDelete: SetNull)

  @@unique([produtoId, processoId])
  @@index([processoId])
  @@index([maquinaId])
  @@map("produto_processos")
}

// ─── 8.4 Comercial ──────────────────────────────────────────────────────────

enum StatusSolicitacao {
  nova
  em_atendimento
  orcada
  descartada

  @@map("status_solicitacao")
}

enum StatusOrcamento {
  rascunho
  enviado
  em_negociacao
  aprovado
  recusado
  expirado
  convertido

  @@map("status_orcamento")
}

enum StatusPedido {
  aguardando_arte
  arte_em_aprovacao
  em_producao
  pronto
  em_entrega
  entregue
  cancelado

  @@map("status_pedido")
}

enum StatusFinanceiroPedido {
  pendente
  parcial
  pago

  @@map("status_financeiro_pedido")
}

enum TipoEntrega {
  retirada
  entrega
  instalacao

  @@map("tipo_entrega")
}

enum Prioridade {
  baixa
  normal
  alta
  urgente

  @@map("prioridade")
}

enum StatusArte {
  aguardando_arquivo
  em_criacao
  enviada_cliente
  ajuste_solicitado
  aprovada

  @@map("status_arte")
}

enum StatusEntrega {
  pendente
  agendada
  realizada
  cancelada

  @@map("status_entrega")
}

model SolicitacaoOrcamento {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero            String            @unique
  clienteId         String?           @map("cliente_id") @db.Uuid
  origem            String
  descricao         String
  prazoDesejado     DateTime?         @map("prazo_desejado") @db.Date
  status            StatusSolicitacao @default(nova)
  responsavelId     String?           @map("responsavel_id") @db.Uuid
  /// Vínculo futuro com uma conversa do WhatsApp (Fase 9)
  referenciaExterna String?           @map("referencia_externa")
  motivoDescarte    String?           @map("motivo_descarte")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         String?           @map("created_by") @db.Uuid

  cliente     Cliente?    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  responsavel Usuario?    @relation("SolicitacaoResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  orcamentos  Orcamento[]

  @@index([status])
  @@index([clienteId])
  @@index([responsavelId])
  @@map("solicitacoes_orcamento")
}

model Orcamento {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero                String          @unique
  clienteId             String          @map("cliente_id") @db.Uuid
  vendedorId            String?         @map("vendedor_id") @db.Uuid
  solicitacaoId         String?         @map("solicitacao_id") @db.Uuid
  validade              DateTime        @db.Date
  status                StatusOrcamento @default(rascunho)
  statusPersonalizadoId String?         @map("status_personalizado_id") @db.Uuid
  subtotal              Decimal         @default(0) @db.Decimal(12, 2)
  desconto              Decimal         @default(0) @db.Decimal(12, 2)
  acrescimo             Decimal         @default(0) @db.Decimal(12, 2)
  frete                 Decimal         @default(0) @db.Decimal(12, 2)
  total                 Decimal         @default(0) @db.Decimal(12, 2)
  custoEstimado         Decimal         @default(0) @map("custo_estimado") @db.Decimal(12, 2)
  prazoDias             Int             @default(0) @map("prazo_dias")
  condicoes             String?
  observacoes           String?
  observacoesInternas   String?         @map("observacoes_internas")
  tokenPublico          String          @unique @map("token_publico")
  enviadoEm             DateTime?       @map("enviado_em") @db.Timestamptz(3)
  aprovadoEm            DateTime?       @map("aprovado_em") @db.Timestamptz(3)
  aprovadoPorNome       String?         @map("aprovado_por_nome")
  aprovadoIp            String?         @map("aprovado_ip")
  recusadoEm            DateTime?       @map("recusado_em") @db.Timestamptz(3)
  motivoRecusa          String?         @map("motivo_recusa")
  pedidoId              String?         @unique @map("pedido_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy             String?         @map("created_by") @db.Uuid

  statusPersonalizado StatusConfig?         @relation("OrcamentoStatusPersonalizado", fields: [statusPersonalizadoId], references: [id], onDelete: SetNull)
  cliente             Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor            Usuario?              @relation("OrcamentoVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  solicitacao         SolicitacaoOrcamento? @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)
  pedido              Pedido?               @relation("PedidoDoOrcamento", fields: [pedidoId], references: [id], onDelete: Restrict)
  itens               OrcamentoItem[]

  @@index([status])
  @@index([clienteId])
  @@index([vendedorId])
  @@index([validade])
  @@index([createdAt])
  @@map("orcamentos")
}

model OrcamentoItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orcamentoId        String   @map("orcamento_id") @db.Uuid
  produtoId          String   @map("produto_id") @db.Uuid
  descricao          String
  quantidade         Decimal  @db.Decimal(12, 3)
  largura            Decimal? @db.Decimal(10, 3)
  altura             Decimal? @db.Decimal(10, 3)
  /// Área total cobrada (m²)
  areaM2             Decimal  @default(0) @map("area_m2") @db.Decimal(12, 3)
  precoUnitario      Decimal  @map("preco_unitario") @db.Decimal(12, 2)
  valorProduto       Decimal  @map("valor_produto") @db.Decimal(12, 2)
  valorAcabamentos   Decimal  @default(0) @map("valor_acabamentos") @db.Decimal(12, 2)
  desconto           Decimal  @default(0) @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  custoEstimado      Decimal  @default(0) @map("custo_estimado") @db.Decimal(12, 2)
  /// Linhas do custo direto com as medidas reais (CustoVenda)
  custoDetalhe       Json?    @map("custo_detalhe")
  prazoDias          Int      @default(0) @map("prazo_dias")
  ordem              Int
  observacao         String?
  /// Quem liberou o preço abaixo do mínimo (permissão "aprovar")
  precoLiberadoPorId String?  @map("preco_liberado_por") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orcamento        Orcamento                 @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto          Produto                   @relation("OrcamentoItemProduto", fields: [produtoId], references: [id], onDelete: Restrict)
  precoLiberadoPor Usuario?                  @relation("PrecoLiberadoPor", fields: [precoLiberadoPorId], references: [id], onDelete: SetNull)
  acabamentos      OrcamentoItemAcabamento[]

  @@index([orcamentoId])
  @@index([produtoId])
  @@map("orcamento_itens")
}

model OrcamentoItemAcabamento {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String       @map("item_id") @db.Uuid
  acabamentoId  String       @map("acabamento_id") @db.Uuid
  nome          String
  tipoCobranca  TipoCobranca @map("tipo_cobranca")
  valorUnitario Decimal      @map("valor_unitario") @db.Decimal(12, 2)
  base          Decimal      @db.Decimal(12, 3)
  valor         Decimal      @db.Decimal(12, 2)
  /// Custo do acabamento no momento da venda (manual + insumos)
  custo         Decimal      @default(0) @db.Decimal(12, 2)

  item       OrcamentoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  acabamento Acabamento    @relation("OrcamentoItemAcabamento", fields: [acabamentoId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@map("orcamento_item_acabamentos")
}

model Pedido {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero                String                 @unique
  clienteId             String                 @map("cliente_id") @db.Uuid
  vendedorId            String?                @map("vendedor_id") @db.Uuid
  dataPrevistaEntrega   DateTime               @map("data_prevista_entrega") @db.Date
  status                StatusPedido           @default(aguardando_arte)
  /// Coluna própria do kanban (status criado pelo usuário com base = status)
  statusPersonalizadoId String?                @map("status_personalizado_id") @db.Uuid
  statusFinanceiro      StatusFinanceiroPedido @default(pendente) @map("status_financeiro")
  tipoEntrega           TipoEntrega            @default(retirada) @map("tipo_entrega")
  /// Endereço de entrega/instalação (cópia do endereço do cliente no momento do pedido)
  enderecoEntrega       String?                @map("endereco_entrega")
  subtotal              Decimal                @db.Decimal(12, 2)
  desconto              Decimal                @default(0) @db.Decimal(12, 2)
  acrescimo             Decimal                @default(0) @db.Decimal(12, 2)
  frete                 Decimal                @default(0) @db.Decimal(12, 2)
  total                 Decimal                @db.Decimal(12, 2)
  valorPago             Decimal                @default(0) @map("valor_pago") @db.Decimal(12, 2)
  prioridade            Prioridade             @default(normal)
  observacoes           String?
  observacoesInternas   String?                @map("observacoes_internas")
  motivoCancelamento    String?                @map("motivo_cancelamento")
  canceladoEm           DateTime?              @map("cancelado_em") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy             String?                @map("created_by") @db.Uuid

  statusPersonalizado  StatusConfig?         @relation("PedidoStatusPersonalizado", fields: [statusPersonalizadoId], references: [id], onDelete: SetNull)
  cliente              Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor             Usuario?              @relation("PedidoVendedor", fields: [vendedorId], references: [id], onDelete: Restrict)
  orcamento            Orcamento?            @relation("PedidoDoOrcamento")
  itens                PedidoItem[]
  entregas             Entrega[]
  contasReceber        ContaReceber[]
  comissoes            Comissao[]
  ordensProducao       OrdemProducao[]
  etiquetasFila        EtiquetaFila[]
  movimentacoesEstoque EstoqueMovimentacao[] @relation("MovimentacaoPedido")

  @@index([status])
  @@index([clienteId])
  @@index([vendedorId])
  @@index([dataPrevistaEntrega])
  @@index([createdAt])
  @@map("pedidos")
}

model PedidoItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId         String   @map("pedido_id") @db.Uuid
  orcamentoItemId  String?  @map("orcamento_item_id") @db.Uuid
  produtoId        String   @map("produto_id") @db.Uuid
  descricao        String
  quantidade       Decimal  @db.Decimal(12, 3)
  largura          Decimal? @db.Decimal(10, 3)
  altura           Decimal? @db.Decimal(10, 3)
  areaM2           Decimal  @default(0) @map("area_m2") @db.Decimal(12, 3)
  precoUnitario    Decimal  @map("preco_unitario") @db.Decimal(12, 2)
  valorProduto     Decimal  @map("valor_produto") @db.Decimal(12, 2)
  valorAcabamentos Decimal  @default(0) @map("valor_acabamentos") @db.Decimal(12, 2)
  desconto         Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  custoEstimado    Decimal  @default(0) @map("custo_estimado") @db.Decimal(12, 2)
  /// Linhas do custo direto (CustoVenda), copiadas do orçamento
  custoDetalhe     Json?    @map("custo_detalhe")
  prazoDias        Int      @default(0) @map("prazo_dias")
  ordem            Int
  observacao       String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedido         Pedido                 @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto        Produto                @relation("PedidoItemProduto", fields: [produtoId], references: [id], onDelete: Restrict)
  acabamentos    PedidoItemAcabamento[]
  artes          Arte[]
  ordensProducao OrdemProducao[]

  @@index([pedidoId])
  @@index([produtoId])
  @@map("pedido_itens")
}

model PedidoItemAcabamento {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String       @map("item_id") @db.Uuid
  acabamentoId  String       @map("acabamento_id") @db.Uuid
  nome          String
  tipoCobranca  TipoCobranca @map("tipo_cobranca")
  valorUnitario Decimal      @map("valor_unitario") @db.Decimal(12, 2)
  base          Decimal      @db.Decimal(12, 3)
  valor         Decimal      @db.Decimal(12, 2)
  /// Custo do acabamento no momento da venda (manual + insumos)
  custo         Decimal      @default(0) @db.Decimal(12, 2)

  item       PedidoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  acabamento Acabamento @relation("PedidoItemAcabamento", fields: [acabamentoId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@map("pedido_item_acabamentos")
}

model Arte {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoItemId      String     @map("pedido_item_id") @db.Uuid
  versao            Int
  arquivoId         String?    @map("arquivo_id") @db.Uuid
  miniaturaId       String?    @map("miniatura_id") @db.Uuid
  status            StatusArte @default(aguardando_arquivo)
  comentarioCliente String?    @map("comentario_cliente")
  designerId        String?    @map("designer_id") @db.Uuid
  tokenPublico      String     @unique @map("token_publico")
  aprovadaEm        DateTime?  @map("aprovada_em") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedidoItem  PedidoItem       @relation(fields: [pedidoItemId], references: [id], onDelete: Cascade)
  arquivo     Arquivo?         @relation("ArteArquivo", fields: [arquivoId], references: [id], onDelete: SetNull)
  miniatura   Arquivo?         @relation("ArteMiniatura", fields: [miniaturaId], references: [id], onDelete: SetNull)
  designer    Usuario?         @relation("ArteDesigner", fields: [designerId], references: [id], onDelete: SetNull)
  comentarios ArteComentario[]

  @@unique([pedidoItemId, versao])
  @@index([status])
  @@map("artes")
}

model Entrega {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId      String        @map("pedido_id") @db.Uuid
  tipo          TipoEntrega
  dataAgendada  DateTime?     @map("data_agendada") @db.Timestamptz(3)
  dataRealizada DateTime?     @map("data_realizada") @db.Timestamptz(3)
  responsavelId String?       @map("responsavel_id") @db.Uuid
  recebidoPor   String?       @map("recebido_por")
  comprovanteId String?       @map("comprovante_id") @db.Uuid
  endereco      String?
  status        StatusEntrega @default(pendente)
  observacao    String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  responsavel Usuario? @relation("EntregaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  comprovante Arquivo? @relation("EntregaComprovante", fields: [comprovanteId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([status])
