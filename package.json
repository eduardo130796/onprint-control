{
  "name": "onprint-control",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @onprint/shared && npm run build -w @onprint/api && npm run build -w @onprint/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f --tail=100",
    "migrate": "docker compose exec api npm run prisma:migrate -w @onprint/api --",
    "reset": "docker compose exec api npm run prisma:reset -w @onprint/api",
    "seed": "docker compose exec api npm run prisma:seed -w @onprint/api",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
